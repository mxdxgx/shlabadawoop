{
  "name": "shlabadawoop",
  "version": "1.5.1",
  "description": "shlabadawoop node.js api written in typescript for sheer, unlimited joy",
  "scripts": {
    "clean": "rimraf dist && rimraf coverage",
    "prebuild": "npm run clean",
    "build": "tsc",
    "format": "prettier --write \"{src,config}/**/*.ts\" package.json tsconfig.json eslint.config.mjs README.md",
    "pretest": "npm run build",
    "test": "nyc --all --include \"src/**/*.ts\" --include \"config/**/*.ts\" --exclude \"**/*.spec.ts\" --check-coverage --branches 100 --functions 100 --lines 100 --statements 100 mocha --timeout 15000 --require ts-node/register \"src/**/*.spec.ts\" \"config/**/*.spec.ts\"",
    "start": "node dist/src/start.js",
    "start-remote": "node --inspect=0.0.0.0:9229 dist/src/start.js",
    "start:dev": "nodemon",
    "prepare": "husky",
    "lint": "eslint src config",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm audit --audit-level=low",
    "format:check": "prettier --check \"{src,config}/**/*.ts\" package.json tsconfig.json eslint.config.mjs README.md"
  },
  "author": "Maxime G",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@types/chai": "^4.3.20",
    "@types/config": "^3.3.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/sinon": "^17.0.3",
    "@types/supertest": "^6.0.3",
    "chai": "^4.5.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "mocha": "^11.8.0",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sinon": "^17.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "config": "^5.0.0",
    "express": "^5.2.1",
    "express-winston": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "lodash": "^4.18.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "winston": "^3.19.0",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "eslint": {
      "ajv": "6.15.0",
      "brace-expansion": "1.1.18",
      "minimatch": "3.1.5"
    },
    "mocha": {
      "diff": "8.0.3",
      "js-yaml": "4.3.1",
      "serialize-javascript": "7.0.5"
    },
    "nodemon": {
      "braces": "3.0.3",
      "picomatch": "2.3.2"
    },
    "nyc": {
      "js-yaml": "3.15.1"
    },
    "ts-node": {
      "diff": "4.0.4"
    }
  }
}
